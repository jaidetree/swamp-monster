{
  "name": "swamp-monster-leather",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i static_src/css/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i static_src/css/input.css -o static/css/app.css --watch",
    "build": "npm run build:css",
    "dev": "concurrently -n css,django -c yellow,green \"npm:watch:css\" \"./manage.py runserver\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "heroicons": "^2.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-django-templates": "^0.2.0",
    "tailwindcss": "^4.1.12"
  }
}
